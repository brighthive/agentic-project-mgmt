<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="TradeDW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=dw-sql;Initial Catalog=TradeDW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Blotter">
      <Query>
        <DataSourceName>TradeDW</DataSourceName>
        <CommandText>SELECT * FROM dbo.FactTrade f JOIN dbo.SecurityMaster s ON f.SecurityId = s.SecurityId</CommandText>
      </Query>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!TradeTs.Value</FilterExpression>
          <Operator>GreaterThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!AsOfDate.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="AsOfDate">
      <DataType>DateTime</DataType>
    </ReportParameter>
  </ReportParameters>
  <Body>
    <ReportItems>
      <Tablix Name="TblotterTable">
        <SortExpressions>
          <SortExpression>
            <Value>=Fields!TradeTs.Value</Value>
            <Direction>Descending</Direction>
          </SortExpression>
        </SortExpressions>
        <DataSetName>Blotter</DataSetName>
      </Tablix>
    </ReportItems>
  </Body>
</Report>
